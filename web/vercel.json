{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/callback", "destination": "/index.html" },
    { "source": "/visualizer", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/recompute",
      "schedule": "*/5 * * * *"
    }
  ]
}
